# ════════════════════════════════════════════════
# 아테나 복지서비스 — 환경변수 예시 (실제 값 절대 입력 금지)
# 이 파일은 GitHub에 올라갑니다. 실제 키는 Railway Variables에만 저장하세요.
# ════════════════════════════════════════════════

# ── 공공데이터포털 복지서비스 API (data.go.kr) ──
GOV_WELFARE_API_KEY=여기에_입력_하지_마세요_Railway에_등록

# ── Supabase (정책 DB) ───────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJ...여기에_입력_하지_마세요_Railway에_등록

# ── 복지로 Open API (선택, 승인 후 입력) ──────────
BOKJIRO_API_KEY=여기에_입력_하지_마세요_Railway에_등록

# ── API 키 / 시크릿 ──────────────────────────────
.env
.env.*
.env.local
.env.production
!.env.example
secrets.json
secrets.yaml
config/local_settings.py
*.key
*.pem
*_secret*
*_token*

# ── 데이터베이스 (사용자 데이터 포함 가능) ───────────
*.db
*.sqlite
*.sqlite3
db/*.db
db/*.sqlite3
data/*.db
data/*.sqlite3
data/raw/
data/processed/
data/personal/

# ── Draft / 보고서 (개인정보 포함) ──────────────────
reports/
!reports/.gitkeep

# ── claudecode 내부 설정 (경로·이메일 포함 가능) ──────
claudecode.md
.claude/
*.claudecode

# ── 로그 파일 ────────────────────────────────────
*.log
logs/

